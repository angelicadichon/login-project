{
    "name": "login-system",
    "version": "1.0.0",
    "description": "Secure login system with Firebase",
    "scripts": {
      "dev": "cd frontend && npm start",
      "build": "cd frontend && npm run build",
      "test": "cd frontend && npm test",
      "deploy:hosting": "firebase deploy --only hosting",
      "deploy:functions": "cd functions && npm run build && firebase deploy --only functions",
      "deploy:rules": "firebase deploy --only firestore:rules",
      "deploy:all": "npm run build && firebase deploy",
      "install:all": "cd frontend && npm install && cd ../functions && npm install"
    },
    "keywords": ["react", "firebase", "authentication", "login"],
    "author": "Your Name",
    "license": "MIT",
    "engines": {
      "node": ">=18.0.0"
    }
  }